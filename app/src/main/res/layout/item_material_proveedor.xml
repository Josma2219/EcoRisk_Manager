<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="@color/color_superficie"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/textoNombreMaterial"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/texto_primario"
            android:textSize="17sp"
            android:textStyle="bold"
            tools:text="Ácido Sulfúrico" />

        <TextView
            android:id="@+id/textoCodigoMaterial"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:textColor="@color/texto_secundario"
            android:textSize="13sp"
            tools:text="Código: MAT-001" />

        <TextView
            android:id="@+id/textoRiesgoMaterial"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_chip"
            android:paddingStart="12dp"
            android:paddingTop="4dp"
            android:paddingEnd="12dp"
            android:paddingBottom="4dp"
            android:textColor="@color/blanco"
            android:textSize="11sp"
            android:textStyle="bold"
            tools:text="Riesgo: Corrosivo" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:background="@color/color_borde_suave" />

        <TextView
            android:id="@+id/textoProveedor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="@color/texto_primario"
            android:textSize="15sp"
            android:textStyle="bold"
            tools:text="Proveedor: Químicos del Norte" />

        <TextView
            android:id="@+id/textoCorreoProveedor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:textColor="@color/texto_secundario"
            android:textSize="13sp"
            tools:text="Correo: ventas@quimicosnorte.com" />

        <TextView
            android:id="@+id/textoPrecioReferencia"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/color_secundario"
            android:textSize="16sp"
            android:textStyle="bold"
            tools:text="Precio referencia: ₡15000.0" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/botonEliminarRelacion"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="12dp"
            android:text="Eliminar relación"
            android:textColor="@color/riesgo_critico"
            app:cornerRadius="10dp"
            app:strokeColor="@color/riesgo_critico" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
